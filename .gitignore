.venv/

/submissions/
/.quarto/
# Live version of the slides (quarto ... --profile live), never published
*.live.html
# Rendered slides: the repository keeps the PDFs only
lecture-slides/*.html
# ... except the slide-log script that the live decks include
!lecture-slides/_slide-log.html
lecture-slides/*_cache/
lecture-slides/*_files/
**/*.quarto_ipynb
**/*.quarto_ipynb_*
.claude/settings.local.json
# Trading game token: set_token() saves it here (R: .Renviron, Python: .env)
.Renviron
.env
/.uvr/library/
/.uvr/activate*

# data/ holds the public datasets of the course (made by data-raw/public_data.R);
# the licensed files from Absalon stay local and never go to GitHub
data/*
!data/.gitkeep
!data/factors_ff3_monthly.parquet
!data/industries_ff_monthly.parquet
!data/macro_predictors.parquet
!data/cpi_monthly.parquet
# CPZ light search: per-run logs and the results lock
lecture-slides/factor-zoo/logs/
lecture-slides/factor-zoo/results/.cpz_light_runs.lock

# Made by aef-07 on every render, from CRSP
lecture-slides/figures/beta-sort-step-*.png

# Assignment texts: rendered to PDF here and shared on Absalon at release, never on GitHub
/mandatory-assignments/texts/
